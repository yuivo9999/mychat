# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public origin of this application. When configured, it is accepted as an
# alternative command-request origin when the proxy changes the Host header.
APP_URL="http://localhost:3000"

# Agent command execution is intentionally disabled by default. Enable it only for trusted
# users and deploy the application in a dedicated container or a stronger per-execution sandbox.
AGENT_COMMAND_EXECUTION_ENABLED=false

# Isolated temporary directory. It must be writable by the OS user that starts server.ts.
AGENT_COMMAND_WORK_ROOT="/tmp/ivochat-agent-command"

# Execution limits.
AGENT_COMMAND_TIMEOUT_MS=120000
AGENT_COMMAND_MAX_OUTPUT_BYTES=524288
AGENT_COMMAND_MAX_LENGTH=16000
AGENT_COMMAND_MAX_WORKSPACE_FILES=1200
AGENT_COMMAND_MAX_FILE_BYTES=10485760
AGENT_COMMAND_MAX_TOTAL_BYTES=157286400
AGENT_COMMAND_MAX_SCAN_FILES=5000
AGENT_COMMAND_MAX_CONCURRENCY=2

# Root-only defense in depth. If server.ts starts as root, the child is spawned with the
# numeric UID/GID below. If the server already runs as non-root (as in Dockerfile), this
# option has no effect and should remain false.
AGENT_COMMAND_DROP_PRIVILEGES=false
AGENT_COMMAND_UID=65534
AGENT_COMMAND_GID=65534
